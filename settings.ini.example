[general]
data_dir = ./data
listen = :8080
public_url = http://localhost:8080

[archive]
; archive_all = true
; include_snapshots = false
; include_prereleases = false
; include_rc = false
; include_alpha = false
; include_beta = false
; versions_file = versions.txt
; versions = 1.20.1,1.19.4
client_only = false
server_only = false
workers = 8
retry_max = 5
retry_base_ms = 500
auto_refresh = true
refresh_min = 60
; agent_id = my-agent-1
; coordinator_stale_sec = 3600

[cache]
enabled = true
max_entries = 512
max_mb = 512
shards = 256

[server]
inventory_ttl_sec = 30
; trust_proxy = true
; proxy_on_miss = false
; proxy_cache = true

[stats]
enabled = false

[p2p]
enabled = false
peers = http://peer1:8080,http://peer2:8080
timeout_sec = 30

; S3-compatible object storage backend (AWS S3, MinIO, Cloudflare R2,
; Backblaze B2, DigitalOcean Spaces, ...). When enabled, archive content,
; coordinator state, and indexes live in the bucket; data_dir is still used
; for in-flight .part downloads and upload staging.
[s3]
; enabled = false
; bucket = my-minecraft-archive
; prefix = minecraft            ; optional key prefix inside the bucket
; endpoint =                    ; host[:port] or https://... ; empty = AWS S3
; region =                      ; e.g. us-east-1, auto1 (R2), etc.
; path_style = false            ; true for MinIO and most S3-compatible stores
; use_ssl = true                ; ignored when endpoint has an http(s) scheme
; anonymous = false             ; public buckets: never sign requests
; access_key =                  ; private buckets: static credentials
; secret_key =
; session_token =
; redirect = false              ; serve files via presigned URL redirects
; redirect_ttl = 15m            ; presigned URL lifetime
